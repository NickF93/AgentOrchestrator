# .env.example — Per-workstation environment configuration
#
# Copy this file to .env and adjust for your local setup.
# .env is gitignored and never committed.
#
# AGENT_PYTHON: the Python command used by run-gates.sh and documented
# in adapter files. Set this to match your local environment.
#
# Examples (illustrative only):
#   AGENT_PYTHON="python3"                         # system Python
#   AGENT_PYTHON="conda run -n myenv python"      # conda environment
#   AGENT_PYTHON="/home/user/.venvs/agent/bin/python"  # virtualenv
AGENT_PYTHON="python3"
