{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agent-os/schemas/plan.schema.json",
  "title": "Agent Plan Schema",
  "type": "object",
  "required": [
    "meta",
    "mission",
    "milestones",
    "sprints",
    "items",
    "commit_groups"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["repo", "owner", "version", "schema_version", "last_updated"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "last_updated": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "mission": { "type": "string", "minLength": 1 },
    "milestones": {
      "type": "array",
      "items": { "$ref": "#/$defs/container" }
    },
    "sprints": {
      "type": "array",
      "items": { "$ref": "#/$defs/container" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "commit_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/commitGroup" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "ready",
        "in_progress",
        "blocked",
        "review",
        "verified",
        "done"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "orchestrator",
        "implementer",
        "tester",
        "reviewer",
        "documenter",
        "researcher"
      ]
    },
    "effort": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "action": {
      "type": "string",
      "enum": [
        "audit",
        "plan",
        "design",
        "implement",
        "refactor",
        "test",
        "verify",
        "document",
        "review",
        "checkpoint",
        "decide",
        "migrate"
      ]
    },
    "container": {
      "type": "object",
      "required": ["id", "type", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["X", "S"] },
        "title": { "type": "string", "minLength": 1 },
        "parent": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["id", "type", "title", "status", "role", "effort"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parent": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["Q", "D", "M", "F", "T", "C"] },
        "title": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/action" }
        },
        "status": { "$ref": "#/$defs/status" },
        "role": { "$ref": "#/$defs/role" },
        "effort": { "$ref": "#/$defs/effort" },
        "commit_group": { "$ref": "#/$defs/id" },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "scope": {
          "type": "string",
          "pattern": "^(\\.|[A-Za-z0-9._/-]+)$"
        },
        "decision": { "type": "string" },
        "checks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifacts_in": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifacts_out": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" },
        "triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tools_profile": { "type": "string" }
      },
      "additionalProperties": true
    },
    "commitGroup": {
      "type": "object",
      "required": ["id", "title", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
