{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/agent-os/schemas/plan-index.schema.json",
  "title": "Agent Split Plan Index Schema",
  "type": "object",
  "required": ["meta", "mission", "current_plan", "archive_root", "archives"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["repo", "owner", "version", "schema_version", "last_updated"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "last_updated": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "mission": { "type": "string", "minLength": 1 },
    "current_plan": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "archive_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "archives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["milestone", "title", "path", "digest"],
        "properties": {
          "milestone": {
            "type": "string",
            "pattern": "^X[1-9][0-9]*$"
          },
          "title": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{12}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
