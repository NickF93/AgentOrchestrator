#!/usr/bin/env sh
# Enforce commit title and Refs footer contract.

set -eu

msg_file="$1"
title_pattern='^([a-z]+)\(([a-z0-9._/-]+)\): .+$'
item_pattern='[A-Z]+[1-9][0-9]*\.[1-9][0-9]*\.[1-9][0-9]*[a-z]?'
cg_pattern='cg[1-9][0-9]*'
ai_target_pattern='anthropic|openai|chatgpt|gpt-[0-9]+([.][0-9]+)?|claude (code|opus|sonnet|haiku)|github copilot|copilot|codex|gemini|grok|cursor ai|kilocode|codeium|tabnine|replit ai|deepseek'
ai_trace_pattern="(Co-[Aa]uthored-[Bb]y:|Generated (by|with)[: ]+).*((${ai_target_pattern}))"

first_line="$(sed -n '1p' "$msg_file")"
refs_count="$(grep -Ec '^Refs: ' "$msg_file" || true)"

if ! printf '%s\n' "$first_line" | grep -Eq "$title_pattern"; then
  cat >&2 <<'EOF'
ERROR: Invalid commit title format.
Expected: <type>(<scope>): <description>
Example: feat(scripts): enforce commit footer hook
Regex: ^([a-z]+)\(([a-z0-9._/-]+)\): .+$
EOF
  exit 1
fi

if [ "$refs_count" -ne 1 ]; then
  cat >&2 <<'EOF'
ERROR: Expected exactly one Refs footer line.
Format: Refs: <PLAN item IDs>, <commit_group ID>
Example: Refs: D1.1.1, cg1
EOF
  exit 1
fi

refs_line="$(grep -E '^Refs: ' "$msg_file")"
item_count="$(printf '%s\n' "$refs_line" | grep -Eo "$item_pattern" | wc -l | tr -d ' ')"
cg_count="$(printf '%s\n' "$refs_line" | grep -Eo "$cg_pattern" | wc -l | tr -d ' ')"

if [ "${item_count:-0}" -lt 1 ] || [ "${cg_count:-0}" -ne 1 ]; then
  cat >&2 <<'EOF'
ERROR: Refs footer must include at least one PLAN item ID and exactly one commit_group ID.
Format: Refs: <PLAN item IDs>, <commit_group ID>
Example: Refs: D1.1.1, cg1
EOF
  exit 1
fi

if grep -Eiq "$ai_trace_pattern" "$msg_file"; then
  cat >&2 <<'EOF'
ERROR: Commit message contains forbidden AI/codegen attribution markers.
Blocked markers include Co-Authored-By and Generated by/with when attributed
to an AI model, vendor, or code-generation tool.
Legitimate human co-author trailers remain allowed.
EOF
  exit 1
fi

exit 0
