#!/usr/bin/env bash
# Prevent direct pushes to protected branches and block AI/codegen traces.

set -euo pipefail

remote_name="${1:-origin}"
remote_url="${2:-}"
zero_oid='0000000000000000000000000000000000000000'
ai_target_pattern='anthropic|openai|chatgpt|gpt-[0-9]+([.][0-9]+)?|claude (code|opus|sonnet|haiku)|github copilot|copilot|codex|gemini|grok|cursor ai|kilocode|codeium|tabnine|replit ai|deepseek'
ai_trace_pattern="(Co-[Aa]uthored-[Bb]y:|Generated (by|with)[: ]+).*((${ai_target_pattern}))"

: "${remote_url}"

contains_banned_ai_trace() {
  grep -Eiq "$ai_trace_pattern"
}

fail_trace() {
  local context="$1"
  cat >&2 <<EOF
ERROR: ${context} contains forbidden AI/codegen attribution markers.
Blocked markers include Co-Authored-By and Generated by/with when attributed
to an AI model, vendor, or code-generation tool.
Legitimate human co-author trailers remain allowed.

Canonical policy:
- AGENTS.md
- agent-os/workflow/git-flow-policy.md
EOF
  exit 1
}

list_push_commits() {
  local local_sha="$1"
  local remote_sha="$2"

  if [[ "$remote_sha" == "$zero_oid" ]]; then
    if git for-each-ref --format='%(refname)' "refs/remotes/${remote_name}" | grep -q .; then
      git rev-list "$local_sha" --not --remotes="$remote_name"
    else
      git rev-list "$local_sha"
    fi
  else
    git rev-list "${remote_sha}..${local_sha}"
  fi
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue

  if [[ "$local_sha" == "$zero_oid" ]]; then
    continue
  fi

  case "$remote_ref" in
    refs/heads/main|refs/heads/develop)
      cat >&2 <<'EOF'
ERROR: Direct pushes to main and develop are forbidden.
Push a topic branch and merge through a PR instead.

Canonical policy:
- AGENTS.md
- agent-os/workflow/git-flow-policy.md
EOF
      exit 1
      ;;
  esac

  while read -r commit; do
    [[ -z "${commit:-}" ]] && continue

    if git log -1 --format=%B "$commit" | contains_banned_ai_trace; then
      fail_trace "Commit message in ${commit}"
    fi

    added_lines="$(
      git show --format= --unified=0 --no-color "$commit" \
        | awk '/^\+[^+]/ {sub(/^\+/, ""); print}'
    )"
    if [[ -n "$added_lines" ]] && printf '%s\n' "$added_lines" | contains_banned_ai_trace; then
      fail_trace "Added lines in ${commit}"
    fi
  done < <(list_push_commits "$local_sha" "$remote_sha")
done

exit 0
