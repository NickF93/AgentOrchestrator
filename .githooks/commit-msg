#!/usr/bin/env sh
# Enforce commit title contract: <type>(<scope>): <description>

set -eu

msg_file="$1"
pattern='^([a-z]+)\(([a-z0-9._/-]+)\): .+$'

first_line="$(sed -n '1p' "$msg_file")"

if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
ERROR: Invalid commit title format.
Expected: <type>(<scope>): <description>
Example: feat(scripts): enforce commit title hook
Regex: ^([a-z]+)\(([a-z0-9._/-]+)\): .+$

Canonical policy:
- agent-os/workflow/git-automation-policy.md
- AGENTS.md (Commit Message Contract)
EOF

exit 1
